@prefix : <http://example.org/movie#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AnimatedMovie a rdfs:Class ;
    rdfs:label "Animated movie" ;
    rdfs:subClassOf :Movie .

:Genre a rdfs:Class ;
    rdfs:label "Movie genre" .

:Movie a rdfs:Class ;
    rdfs:label "Movie" ;
    rdfs:comment "A movie in the MovieLens dataset." .

:Rating a rdfs:Class ;
    rdfs:label "Rating" .

:Tag a rdfs:Class ;
    rdfs:label "Movie tag" .

:User a rdfs:Class ;
    rdfs:label "MovieLens user" ;
    rdfs:subClassOf foaf:Agent .

:hasAnimationGenre a rdf:Property ;
    rdfs:label "has animation genre" ;
    rdfs:domain :Movie ;
    rdfs:range :Genre ;
    rdfs:subPropertyOf :hasGenre .

:hasGivenRating a owl:ObjectProperty ;
    rdfs:label "has given rating" ;
    rdfs:domain :User ;
    rdfs:range :Rating ;
    owl:inverseOf :ratedBy .

:hasRating a rdf:Property ;
    rdfs:label "has rating" ;
    rdfs:domain :Movie ;
    rdfs:range :Rating .

:hasScore a rdf:Property ;
    rdfs:label "has score" ;
    rdfs:domain :Rating ;
    rdfs:range xsd:decimal .

:hasTag a rdf:Property ;
    rdfs:label "has tag" ;
    rdfs:domain :Movie ;
    rdfs:range :Tag .

:hasTagText a rdf:Property ;
    rdfs:label "has tag text" ;
    rdfs:domain :Tag ;
    rdfs:range xsd:string .

:hasTimestamp a rdf:Property ;
    rdfs:label "has timestamp" ;
    rdfs:domain :Rating ;
    rdfs:range xsd:integer .

:hasTitle a rdf:Property ;
    rdfs:label "has title" ;
    rdfs:domain :Movie ;
    rdfs:range xsd:string .

